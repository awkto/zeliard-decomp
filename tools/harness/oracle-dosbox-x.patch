+} // namespace
+
+/* Called by the normal core before each instruction while CS == BASE. */
+void ORACLE_Exec(void) {
+    if (cpu.pmode) return;
+    uint16_t ip = (uint16_t)reg_eip;
+    uint8_t *p = base_ptr(ip);
+    if (state == ST_TRACE && ip >= 0x7000) menu_check(ip, p);
+    if (p[0] == 0xC6 && memcmp(p, BOUNDARY, 5) == 0) {
+        if (ip == 0x717F || ip == 0x68ED) {
+            on_boundary(ip);
+        } else if (state == ST_TRACE && ip != 0x7358 && ip != 0xA597) {
+            unsigned long &n = (*unknown)[ip];
+            if (n++ == 0) logf("unknown boundary site %04X at frame %lu", ip, frame);
+        }
+        /* execute the instruction ourselves and step over it, so an interrupt taken
+         * right here cannot make the same boundary fire twice */
+        mem_writeb(SegPhys(ds) + 0xFF1A, 0);
+        reg_eip += 5;
+        return;
+    }
+    if (ip == 0x0918) dbg_0918++;
+    if (ip == 0x0918 && state == ST_TRACE && memcmp(p, RNG_ENTRY, 4) == 0) {
+        rng = (uint16_t)(rng * 25173u + 13849u);
+        rng_calls++; rng_total++;
+        reg_ax = rng;
+        reg_eip = 0x092A;                                /* the routine's own near `ret` */
+        return;
+    }
+    if (ip == 0x7628 && (state == ST_RESTORE_KEYS || state == ST_WAIT_RESTORE) && memcmp(p, RESTORE_EXIT, 7) == 0) {
+        logf("restore succeeded (town 7628)");
+        restored = true;
+        if (state == ST_WAIT_RESTORE) state = ST_WAIT_FRAME0;
+    }
+}
+
+/* Called at the top of DOS_Terminate (INT 21h AH=4Ch / 31h / 00, INT 20h).  While
+ * tracing, the game leaving for DOS (the Sage's "No", kenjpro A934 `jmp far [FF00]`)
+ * is the end of the run: one last frames.jsonl line (and its base.bin record, so the
+ * two files stay the same length)
+ *   {"f":N,"site":"exit","base":..,"rng_calls":k,"input":"X","code":AL}
+ * N = the frame the program ended in (the number the next boundary would have had);
+ * rng_calls and input as for a boundary line of that frame.  Then a clean stop (0). */
+void ORACLE_DosExit(uint16_t psp, bool tsr, uint8_t code) {
+    if (state != ST_TRACE) return;
+    fprintf(f_jsonl, "{\"f\":%lu,\"site\":\"exit\",\"base\":\"0x%04X\",\"rng_calls\":%u,\"input\":\"%s\",\"code\":%u}\n",
+            frame, oracle_base_seg, rng_calls, cur_input.c_str(), (unsigned)code);
+    fwrite(base_ptr(0), 1, 65536, f_base);
+    logf("program terminated (PSP %04X, tsr=%d, code %u) at frame %lu", psp, (int)tsr, (unsigned)code, frame);
+    finish(0, "program exited to DOS");
+}
+
+/* Called once per emulated millisecond (TIMER_AddTick). */
+void ORACLE_Tick(void) {
+    if (!inited) init();
+    if (state == ST_OFF || state == ST_DONE) return;
+    ms++;
+    if (ms > max_ms) finish(3, "watchdog: ORACLE_MAX_MS exceeded");
+    if (debug_ms && state < ST_TRACE && ms % debug_ms == 0) {
+        char name[64]; snprintf(name, sizeof name, "/boot_%07lu.png", ms);
+        write_png(outdir + name);
+    }
+    unsigned long t = ms - phase_ms;
+    switch (state) {
+    case ST_WAIT_BASE: {
+        uint16_t off = mem_readw(0x61 * 4), seg = mem_readw(0x61 * 4 + 2);
+        if (seg && off == 0x0109 && memcmp(MemBase + ((uint32_t)seg << 4) + 0x0918, RNG_ENTRY, 4) == 0) {
+            oracle_base_seg = seg;
+            logf("BASE=%04X (INT 61h -> %04X:0109)", seg, seg);
+            state = ST_INTRO; phase_ms = ms;
+        }
+        break;
+    }
+    case ST_INTRO: {
+        /* tap Return (held 120 ms) every 1.5 s until town.bin is loaded at BASE:6000
+         * (its frame-boundary bytes appear at 68ED); then release and stop, because
+         * in the town Return opens the status menu */
+        static bool held = false;
+        if (match(0x68ED, BOUNDARY, 5)) {
+            if (held) { key(KBD_enter, false); held = false; }
+            logf("town.bin loaded after intro");
+            state = do_load ? ST_SETTLE : ST_WAIT_FRAME0; phase_ms = ms; town_boundaries = 0;
+            break;
+        }
+        if (t % 1500 == 1000) { key(KBD_enter, true); held = true; }
+        if (t % 1500 == 1120) { key(KBD_enter, false); held = false; }
+        break;
+    }
+    case ST_SETTLE:
+        if (town_boundaries >= settle) { state = ST_RESTORE_KEYS; phase_ms = ms; logf("F7 restore"); }
+        break;
+    case ST_RESTORE_KEYS: {
+        /* F7 -> Sure?(Y/N) -> y -> list: Down, Space (copy name), Enter.  All holds. */
+        static const struct { unsigned long at; KBD_KEYS k; } seq[] = {
+            {100, KBD_f7}, {1000, KBD_y}, {2500, KBD_down}, {3500, KBD_space}, {4500, KBD_enter}};
+        for (auto &e : seq) {
+            if (t == e.at) key(e.k, true);
+            if (t == e.at + 150) key(e.k, false);
+            if (t == e.at + 100 || t == e.at + 200) logf("keys: FF18=%04X FF17=%02X FF16=%02X", base_ptr(0)[0xFF18] | (base_ptr(0)[0xFF19] << 8), base_ptr(0)[0xFF17], base_ptr(0)[0xFF16]);
+        }
+        if (t == 4660) { state = restored ? ST_WAIT_FRAME0 : ST_WAIT_RESTORE; phase_ms = ms; }
+        break;
+    }
+    case ST_WAIT_RESTORE:
+        if (t > 20000) finish(4, "restore did not complete (see final.png)");
+        break;
+    case ST_WAIT_FRAME0:
+        if (t > 60000) finish(5, "no town boundary after restore");
+        break;
+    case ST_TRACE:
+        if (ms - last_boundary_ms > stall_ms) finish(6, "stalled: no boundary for ORACLE_STALL_MS (an input loop the oracle has no site for?)");
+        break;
+    default:
+        break;
+    }
+}
