@@ -0,0 +1,466 @@
+/*
+ * zel_oracle.cpp -- Zeliard differential-test oracle (decomp-zel docs/HARNESS.md).
+ *
+ * Runs the original game frame by frame from a scripted input and dumps the
+ * shared 64 KB segment BASE at every game-frame boundary.  Everything is driven
+ * by emulated time / emulated instructions, never by the host clock.
+ *
+ * Hooks (the only changes outside this file):
+ *   core_normal.cpp  top of the instruction loop:  ORACLE_Exec() when CS == BASE
+ *   pic.cpp          TIMER_AddTick (every emulated ms): ORACLE_Tick()
+ *
+ * Environment (all optional except ORACLE_OUT):
+ *   ORACLE_OUT        output directory (frames.jsonl, base.bin, frame_NNNNN.png, oracle.log)
+ *   ORACLE_SCRIPT     input script in the port's --script language, or a path to a file holding it
+ *   ORACLE_LOAD       "1" = F7-restore the only *.USR in the game dir before tracing
+ *   ORACLE_PNG_EVERY  K: write frame_NNNNN.png every K trace frames (0 = never)
+ *   ORACLE_SETTLE     town boundaries to wait after the intro before F7 (default 20)
+ *   ORACLE_MAX_MS     emulated-ms watchdog for the whole run (default 600000)
+ *   ORACLE_STALL_MS   while tracing, give up after this many emulated ms without any boundary (default 120000)
+ *   ORACLE_MENU_TICKS wait-loop boundaries: kernel ticks (FF1B) between two boundaries in a menu
+ *                     (default 4*[FF33], the frame length: 20 at speed 5)
+ *   ORACLE_DEBUG_MS   during boot, write boot_<ms>.png every N emulated ms (debugging)
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <string>
+#include <map>
+#include <stdarg.h>
+#include <setjmp.h>
+#include <unistd.h>
+#include <png.h>
+
+#include "dosbox.h"
+#include "mem.h"
+#include "regs.h"
+#include "cpu.h"
+#include "keyboard.h"
+#include "vga.h"
+
+extern HostPt MemBase;
+
+uint16_t oracle_base_seg = 0;        /* 0 until BASE is known; checked by the CPU core */
+
+namespace {
+
+enum { ST_OFF, ST_WAIT_BASE, ST_INTRO, ST_SETTLE, ST_RESTORE_KEYS, ST_WAIT_RESTORE, ST_WAIT_FRAME0, ST_TRACE, ST_DONE };
+
+const uint8_t BOUNDARY[5] = {0xC6, 0x06, 0x1A, 0xFF, 0x00};      /* mov byte [0xff1a],0 */
+const uint8_t RNG_ENTRY[4] = {0x2E, 0xA1, 0x1B, 0xFF};           /* STICK 0918 mov ax,[cs:0xff1b] */
+const uint8_t RESTORE_EXIT[7] = {0xB8, 0xFF, 0xFF, 0xFF, 0x26, 0x86, 0x76}; /* town 7628 mov ax,-1; jmp [7686] */
+
+int state = ST_OFF;
+bool inited = false;
+std::string outdir;
+FILE *f_jsonl = nullptr, *f_base = nullptr, *f_log = nullptr;
+std::string script;
+size_t script_pos = 0;
+unsigned script_left = 0;
+uint8_t script_dirs = 0, script_btns = 0;
+uint8_t script_char = 0;              /* 'C token: FF29 on the token's first frame (0 = none) */
+bool script_char_new = false;
+unsigned png_every = 0, settle = 20;
+unsigned long max_ms = 600000, debug_ms = 0, stall_ms = 120000, last_boundary_ms = 0;
+unsigned menu_ticks = 0;             /* wait-loop boundaries: one per this many kernel ticks (0 = 4*[FF33]) */
+uint16_t last_tick = 0;              /* FF1B (free-running 236.7 Hz tick) at the last boundary */
+bool armed = false;                  /* a wait loop was just entered: its first poll is a boundary */
+unsigned long menu_boundaries = 0;
+bool do_load = false;
+unsigned long ms = 0;                /* emulated ms since start */
+unsigned long phase_ms = 0;          /* ms at which the current boot phase started */
+unsigned town_boundaries = 0;
+bool restored = false;
+uint16_t rng = 0;
+unsigned rng_calls = 0;
+unsigned long frame = 0;
+std::string cur_input = ".";          /* input frame `frame` was played with */
+uint8_t prev_btns = 0;
+uint8_t typed = 0;                    /* the FF29 key applied with the current input (0 = none) */
+std::map<uint16_t, unsigned long> *unknown = nullptr;
+unsigned long dbg_0918 = 0, rng_total = 0;
+
+void logf(const char *fmt, ...) {
+    va_list ap;
+    va_start(ap, fmt);
+    FILE *f = f_log ? f_log : stderr;
+    fprintf(f, "[oracle %8lu ms] ", ms);
+    vfprintf(f, fmt, ap);
+    fputc('\n', f);
+    fflush(f);
+    va_end(ap);
+}
+
+inline uint8_t *base_ptr(uint16_t off) { return MemBase + ((uint32_t)oracle_base_seg << 4) + off; }
+inline bool match(uint16_t off, const uint8_t *b, size_t n) { return memcmp(base_ptr(off), b, n) == 0; }
+
+void write_png(const std::string &path) {
+    /* mode 13h, chain-4: pixel a lives at planar offset ((a & ~3) << 2) | (a & 3) */
+    FILE *fp = fopen(path.c_str(), "wb");
+    if (!fp) { logf("cannot write %s", path.c_str()); return; }
+    png_structp png = png_create_write_struct(PNG_LIBPNG_VER_STRING, nullptr, nullptr, nullptr);
+    png_infop info = png_create_info_struct(png);
+    if (setjmp(png_jmpbuf(png))) { png_destroy_write_struct(&png, &info); fclose(fp); return; }
+    png_init_io(png, fp);
+    png_set_IHDR(png, info, 320, 200, 8, PNG_COLOR_TYPE_RGB, PNG_INTERLACE_NONE,
+                 PNG_COMPRESSION_TYPE_DEFAULT, PNG_FILTER_TYPE_DEFAULT);
+    png_write_info(png, info);
+    static uint8_t row[320 * 3];
+    for (unsigned y = 0; y < 200; y++) {
+        for (unsigned x = 0; x < 320; x++) {
+            uint32_t a = y * 320 + x;
+            uint8_t idx = vga.mem.linear[(((a & ~3u) << 2) | (a & 3u)) & vga.mem.memmask];
+            const RGBEntry &c = vga.dac.rgb[idx];
+            row[x * 3 + 0] = (uint8_t)((c.red << 2) | (c.red >> 4));
+            row[x * 3 + 1] = (uint8_t)((c.green << 2) | (c.green >> 4));
+            row[x * 3 + 2] = (uint8_t)((c.blue << 2) | (c.blue >> 4));
+        }
+        png_write_row(png, row);
+    }
+    png_write_end(png, nullptr);
+    png_destroy_write_struct(&png, &info);
+    fclose(fp);
+}
+
+void finish(int code, const char *why) {
+    logf("finish: %s (frames=%lu, wait-loop boundaries=%lu, harness rng calls=%lu, BASE:0918 entries=%lu, at %04X:%04X)",
+         why, frame, menu_boundaries, rng_total, dbg_0918, SegValue(cs), (unsigned)(uint16_t)reg_eip);
+    if (f_jsonl) fclose(f_jsonl);
+    if (f_base) fclose(f_base);
+    if (state != ST_TRACE || code) write_png(outdir + "/final.png");
+    if (f_log) fclose(f_log);
+    state = ST_DONE;
+    fflush(stdout); fflush(stderr);
+    _exit(code);
+}
+
+void init() {
+    inited = true;
+    const char *o = getenv("ORACLE_OUT");
+    if (!o || !*o) return;                       /* oracle off: plain DOSBox-X */
+    outdir = o;
+    f_log = fopen((outdir + "/oracle.log").c_str(), "w");
+    const char *s = getenv("ORACLE_SCRIPT");
+    if (s) {
+        FILE *sf = fopen(s, "r");
+        if (sf) { char buf[4096]; size_t n; while ((n = fread(buf, 1, sizeof buf, sf)) > 0) script.append(buf, n); fclose(sf); }
+        else script = s;
+    }
+    if ((s = getenv("ORACLE_PNG_EVERY"))) png_every = (unsigned)atoi(s);
+    if ((s = getenv("ORACLE_SETTLE"))) settle = (unsigned)atoi(s);
+    if ((s = getenv("ORACLE_MAX_MS"))) max_ms = strtoul(s, nullptr, 10);
+    if ((s = getenv("ORACLE_STALL_MS"))) stall_ms = strtoul(s, nullptr, 10);
+    if ((s = getenv("ORACLE_MENU_TICKS"))) menu_ticks = (unsigned)atoi(s);
+    if ((s = getenv("ORACLE_DEBUG_MS"))) debug_ms = strtoul(s, nullptr, 10);
+    if ((s = getenv("ORACLE_LOAD"))) do_load = atoi(s) != 0;
+    unknown = new std::map<uint16_t, unsigned long>();
+    state = ST_WAIT_BASE;
+    logf("on: out=%s load=%d png_every=%u settle=%u script=%zu chars", outdir.c_str(), do_load, png_every, settle, script.size());
+}
+
+/* the port's script_next(), token for token (port/main.c) */
+bool script_next() {
+    while (script_left == 0) {
+        while (script_pos < script.size() && (script[script_pos] == ' ' || script[script_pos] == ',' ||
+               script[script_pos] == '\n' || script[script_pos] == '\t' || script[script_pos] == '\r')) script_pos++;
+        if (script_pos >= script.size()) return false;
+        uint8_t d = 0, b = 0;
+        script_char = 0; script_char_new = false;
+        if (script[script_pos] == '\'') {
+            /* 'C types one key: A-Z (either case), 0-9, '< = Backspace (08) */
+            char c = script_pos + 1 < script.size() ? script[script_pos + 1] : 0;
+            if (c >= 'a' && c <= 'z') c = (char)(c - 32);
+            if ((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')) script_char = (uint8_t)c;
+            else if (c == '<') script_char = 0x08;
+            script_char_new = script_char != 0;
+            script_pos += c ? 2 : 1;
+        } else
+        for (; script_pos < script.size(); script_pos++) {
+            char c = script[script_pos];
+            if (c == 'U' || c == 'u') d |= 1;
+            else if (c == 'D' || c == 'd') d |= 2;
+            else if (c == 'L' || c == 'l') d |= 4;
+            else if (c == 'R' || c == 'r') d |= 8;
+            else if (c == 'X' || c == 'x') b |= 1;
+            else if (c == 'M' || c == 'm') b |= 2;
+            else if (c == 'E' || c == 'e') b |= 4;
+            else if (c == 'K' || c == 'k') b |= 8;
+            else if (c == '.') ;
+            else break;
+        }
+        unsigned n = 0;
+        while (script_pos < script.size() && script[script_pos] >= '0' && script[script_pos] <= '9')
+            n = n * 10 + (unsigned)(script[script_pos++] - '0');
+        if (script_pos < script.size() && n == 0 && !d && !b && !script_char && script[script_pos] != '.' &&
+            !(script[script_pos] >= '0' && script[script_pos] <= '9')) {
+            /* unknown character: skip it so we cannot loop forever (the port would too) */
+            logf("script: skipping '%c' at %zu", script[script_pos], script_pos);
+            script_pos++;
+            continue;
+        }
+        script_dirs = d; script_btns = b; script_left = n ? n : 1;
+    }
+    script_left--;
+    return true;
+}
+
+std::string input_name(uint8_t d, uint8_t b) {
+    std::string s;
+    if (d & 1) s += 'U';
+    if (d & 2) s += 'D';
+    if (d & 4) s += 'L';
+    if (d & 8) s += 'R';
+    if (b & 1) s += 'X';
+    if (b & 2) s += 'M';
+    if (b & 4) s += 'E';
+    if (b & 8) s += 'K';
+    return s.empty() ? "." : s;
+}
+
+/* Leave the kernel input state exactly as STICK's INT 9 + timer poll would. */
+void apply_input(uint8_t d, uint8_t b) {
+    uint8_t *p = base_ptr(0);
+    p[0xFF17] = d;                                        /* dirs 1=U 2=D 4=L 8=R */
+    p[0xFF16] = (uint8_t)(b & 3);                         /* bit0 Space (X), bit1 Alt (M) */
+    uint16_t hk = (uint16_t)((b & 4 ? 0x0001 : 0) | (b & 8 ? 0x0286 : 0));
+    p[0xFF18] = (uint8_t)hk; p[0xFF19] = (uint8_t)(hk >> 8);
+    /* edges: what timer_poll_fire_keys (STICK 0122) does on the first poll that sees
+     * the key down; the latches 02BE/02BF are set so that poll does not fire again */
+    if ((b & 1) && !(prev_btns & 1)) p[0xFF1D] = 0xFF;
+    if ((b & 2) && !(prev_btns & 2)) p[0xFF1E] = 0xFF;
+    p[0x02BE] = (b & 1) ? 0x00 : 0xFF;
+    p[0x02BF] = (b & 2) ? 0x00 : 0xFF;
+    prev_btns = b;
+    /* a typed key: STICK's INT 9 (kbd_scan_to_ascii 04D0) leaves its ASCII in FF29 */
+    if (script_char_new) { p[0xFF29] = script_char; script_char_new = false; typed = script_char; }
+    else typed = 0;
+}
+
+void key(KBD_KEYS k, bool down) { KEYBOARD_AddKey(k, down); }
+
+/* site: 0x717F / 0x68ED (the frame loops, name = the hex address), or a wait-loop
+ * site (name given, ip = where the CPU actually was; written as an extra "ip" key) */
+void on_boundary(uint16_t site, const char *name = nullptr, uint16_t ip = 0) {
+    if (site == 0x68ED) town_boundaries++;
+    if (state == ST_RESTORE_KEYS && restored && site == 0x68ED)
+        logf("warning: town frame before the restore key sequence ended; not frame 0");
+    if (state == ST_WAIT_FRAME0 && site == 0x68ED) {
+        state = ST_TRACE;
+        frame = 0; rng = 0; rng_calls = 0; prev_btns = 0; cur_input = ".";
+        f_jsonl = fopen((outdir + "/frames.jsonl").c_str(), "w");
+        f_base = fopen((outdir + "/base.bin").c_str(), "wb");
+        if (!f_jsonl || !f_base) finish(2, "cannot open outputs");
+        logf("trace start: BASE=%04X", oracle_base_seg);
+    }
+    if (state != ST_TRACE) return;
+    last_boundary_ms = ms;
+    last_tick = (uint16_t)(base_ptr(0)[0xFF1B] | (base_ptr(0)[0xFF1C] << 8));
+    armed = false;
+    if (name) {
+        menu_boundaries++;
+        fprintf(f_jsonl, "{\"f\":%lu,\"site\":\"%s\",\"base\":\"0x%04X\",\"rng_calls\":%u,\"input\":\"%s\",\"ip\":\"%04X\"}\n",
+                frame, name, oracle_base_seg, rng_calls, cur_input.c_str(), ip);
+    } else
+        fprintf(f_jsonl, "{\"f\":%lu,\"site\":\"%04X\",\"base\":\"0x%04X\",\"rng_calls\":%u,\"input\":\"%s\"}\n",
+                frame, site, oracle_base_seg, rng_calls, cur_input.c_str());
+    fwrite(base_ptr(0), 1, 65536, f_base);
+    if (png_every && frame % png_every == 0) {
+        char name[64]; snprintf(name, sizeof name, "/frame_%05lu.png", frame);
+        write_png(outdir + name);
+    }
+    rng_calls = 0;
+    if (!script_next()) finish(0, "script done");
+    apply_input(script_dirs, script_btns);
+    cur_input = input_name(script_dirs, script_btns);
+    if (typed) {                                       /* "'A", "'<" (port/main.c the same) */
+        if (cur_input == ".") cur_input.clear();
+        cur_input += '\'';
+        cur_input += typed == 0x08 ? '<' : (char)typed;
+    }
+    frame++;
+}
+
+/* ---------------------------------------------------------------- wait loops
+ * The shops, the status screen, the sage and the yes/no widget have no frame: they
+ * spin on idle_poll / int 61h until a key arrives (docs/HARNESS.md §1, §6).  Their
+ * boundary is the loop's poll instruction, taken (a) on the first poll after the
+ * loop's entry ("armed") and (b) after that whenever >= menu_ticks kernel ticks
+ * (FF1B) have passed since the previous boundary of any kind.  Every site is
+ * recognised by its own code bytes, so a different overlay at the same IP cannot
+ * fire it. */
+const uint8_t SIG_WAITKEY[] = {0xC6,0x06,0x1D,0xFF,0x00,0xC6,0x06,0x1E,0xFF,0x00,0xE8,0x56,0xFE,0xA0,0x1D,0xFF}; /* town 71DF */
+const uint8_t SIG_MENUSEL[] = {0xC6,0x06,0x1D,0xFF,0x00,0xC6,0x06,0x1E,0xFF,0x00,0x53,0xE8,0x17,0x01,0x5B,0x53,
+                               0xE8,0xEB,0xFC,0x5B,0xC6,0x06,0x1A,0xFF,0x00};                                   /* town 7344 */
+const uint8_t SIG_SELECT[]  = {0x2E,0xFF,0x16,0x10,0x01,0x2E,0xFF,0x16,0x12,0x01,0x2E,0xFF,0x16,0x14,0x01,0x2E,0xFF,
+                               0x16,0x16,0x01,0x2E,0xFF,0x16,0x18,0x01,0xF6,0x06,0x01,0xAE,0xFF};               /* select AA58 */
+const uint8_t SIG_SEL_OPEN[] = {0xE8,0xD1,0x09,0x1A,0xC0,0xA2,0x01,0xAE,0x32,0xC9};                            /* select A084 */
+const uint8_t SIG_SEL_DISP[] = {0x8A,0x1E,0xF9,0xAD,0x32,0xFF,0x03,0xDB,0xFF,0xA7,0xC4,0xA0};                  /* select A0B8 */
+const uint8_t SIG_OMOY[]    = {0xC6,0x06,0x1D,0xFF,0x00,0x2E,0xFF,0x16,0x16,0x60,0xF6,0x06,0x1D,0xFF,0xFF,0x74,0xF4}; /* omoypro A044 */
+const uint8_t SIG_KENJ_ARM[] = {0xC6,0x06,0x1D,0xFF,0x00,0xC6,0x06,0x1E,0xFF,0x00,0xC6,0x06,0x56,0xFF,0x00,0xC6,0x06,0x24,0xBB,0x00}; /* kenjpro A568 */
+const uint8_t SIG_KENJ[]    = {0x2E,0xFF,0x16,0x16,0x60,0xC6,0x06,0x1A,0xFF,0x00,0xF6,0x06,0x1E,0xFF,0xFF,0xF9}; /* kenjpro A592 */
+const uint8_t SIG_BANK_ARM[] = {0xC6,0x06,0x29,0xAD,0x00,0xC7,0x06,0x2A,0xAD,0x00,0x00};                       /* bankpro A295 */
+const uint8_t SIG_BANK[]    = {0xCD,0x61,0xE8,0x4F,0x03,0xF6,0xC4,0x01};                                        /* bankpro A2D8 */
+const uint8_t SIG_BANK_W[]  = {0xCD,0x61,0xE8,0xB0,0x01,0xF6,0xC4,0x01};                                        /* bankpro A477 (withdraw) */
+const uint8_t SIG_KENJ_RR[] = {0xCD,0x61,0xA8,0x08,0x75,0xFA};                                                  /* kenjpro A66A: wait for R up */
+const uint8_t SIG_KENJ_RL[] = {0xCD,0x61,0xA8,0x04,0x75,0xFA};                                                  /* kenjpro A67F: wait for L up */
+#define MATCH(off, sig) match(off, sig, sizeof sig)
+
+inline bool select_loaded() { return MATCH(0xAA58, SIG_SELECT) && MATCH(0xA084, SIG_SEL_OPEN); }
+
+void menu_poll(const char *name, uint16_t ip) {
+    uint16_t now = (uint16_t)(base_ptr(0)[0xFF1B] | (base_ptr(0)[0xFF1C] << 8));
+    unsigned n = menu_ticks;
+    if (!n) { uint8_t sp = base_ptr(0)[0xFF33]; n = (sp >= 1 && sp <= 9) ? 4u * sp : 20u; }
+    if (!armed && (uint16_t)(now - last_tick) < n) return;
+    on_boundary(0, name, ip);
+}
+
+/* arm points (a wait loop's entry) and poll sites; called for every instruction in BASE while tracing */
+void menu_check(uint16_t ip, const uint8_t *p) {
+    switch (ip) {
+    case 0x71DF: if (MATCH(0x71DF, SIG_WAITKEY)) armed = true; return;          /* town wait_key */
+    case 0x71EC: if (MATCH(0x71DF, SIG_WAITKEY)) menu_poll("71EC", ip); return;  /*   its test of FF1D|FF1E */
+    case 0x7344: if (MATCH(0x7344, SIG_MENUSEL)) armed = true; return;          /* town menu_select (+ yes_no) */
+    case 0x7358: if (MATCH(0x7344, SIG_MENUSEL)) menu_poll("7358", ip); return;  /*   its poll, before the tests */
+    case 0xA044: if (MATCH(0xA044, SIG_OMOY)) armed = true; return;             /* omoypro: wait for Space */
+    case 0xA04E: if (MATCH(0xA044, SIG_OMOY)) menu_poll("omoy:A04E", ip); return;
+    case 0xA568: if (MATCH(0xA568, SIG_KENJ_ARM) && MATCH(0xA592, SIG_KENJ)) armed = true; return;  /* kenjpro name entry */
+    case 0xA597: if (MATCH(0xA592, SIG_KENJ)) menu_poll("kenj:A597", ip); return;
+    case 0xA295: if (MATCH(0xA295, SIG_BANK_ARM) && MATCH(0xA2D8, SIG_BANK)) armed = true; return;  /* bankpro amount entry */
+    case 0xA2D8: if (MATCH(0xA2D8, SIG_BANK) && MATCH(0xA295, SIG_BANK_ARM)) menu_poll("bank:A2D8", ip); return;
+    case 0xA42A: if (MATCH(0xA42A, SIG_BANK_ARM) && MATCH(0xA477, SIG_BANK_W)) armed = true; return;  /* bankpro withdraw amount entry */
+    case 0xA477: if (MATCH(0xA477, SIG_BANK_W) && MATCH(0xA42A, SIG_BANK_ARM)) menu_poll("bank:A477", ip); return;
+    /* kenjpro's R/L cursor steps spin on int 61h until the key is up (no idle_poll):
+     * polls of the same loop, like select's release waits */
+    case 0xA66A: if (MATCH(0xA66A, SIG_KENJ_RR) && MATCH(0xA592, SIG_KENJ)) menu_poll("kenj:A597", ip); return;
+    case 0xA67F: if (MATCH(0xA67F, SIG_KENJ_RL) && MATCH(0xA592, SIG_KENJ)) menu_poll("kenj:A597", ip); return;
+    case 0xA08C: case 0xA0B8:                                                   /* select: opened / pane dispatch */
+        if (select_loaded() && (ip == 0xA08C || MATCH(0xA0B8, SIG_SEL_DISP))) armed = true;
+        return;
+    case 0xAA58:                                                                /* select idle_poll, not the A084 probe */
+        if (select_loaded() && mem_readw(SegPhys(ss) + (uint16_t)reg_esp) != 0xA087) menu_poll("select:AA58", ip);
+        return;
+    default:
+        /* select's release waits (A0D2 A174 A1C3 A25F A2C1 A373 ...) spin on int 61h alone */
+        if (ip >= 0xA000 && ip < 0xB000 && p[0] == 0xCD && p[1] == 0x61 && select_loaded())
+            menu_poll("select:AA58", ip);
+        return;
+    }
+}
